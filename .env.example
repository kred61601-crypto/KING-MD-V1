PORT=10000
APP_URL=https://your-panel.example.com
ENGINE_URL=https://your-engine.example.com
SERVERS=https://your-engine.example.com
JWT_SECRET=replace-with-a-long-random-secret
PAIR_BRIDGE_KEY=replace-with-the-same-random-key-used-by-the-engine
DATA_DIR=./data

# Optional OAuth sign-in providers (GitHub login requires these values)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub OAuth callback URL must be: ${APP_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: forward issue reports to your Telegram administrator chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
